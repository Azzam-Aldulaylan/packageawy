{
  "name": "workspace-root",
  "lockfileVersion": 3,
  "packages": {
    "": {
      "name": "workspace-root",
      "workspaces": ["packages/*", "packages/a/b"],
      "dependencies": { "foo": "^1.0.0" }
    },
    "node_modules/foo": { "version": "1.0.0", "dependencies": { "helper": "^1.0.0" } },
    "node_modules/helper": { "version": "1.0.0" },
    "node_modules/root-helper": { "version": "1.0.0" },
    "node_modules/@ws/app": { "resolved": "packages/app", "link": true },
    "node_modules/@ws/hoisted": { "resolved": "packages/hoisted", "link": true },
    "node_modules/@ws/nested": { "resolved": "packages/a/b", "link": true },
    "packages/app": { "name": "@ws/app", "dependencies": { "foo": "^2.0.0" } },
    "packages/app/node_modules/foo": {
      "version": "2.0.0",
      "dependencies": { "helper": "^2.0.0", "member-helper": "^2.0.0", "root-helper": "^1.0.0" }
    },
    "packages/app/node_modules/foo/node_modules/helper": { "version": "2.0.0" },
    "packages/app/node_modules/member-helper": { "version": "2.0.0" },
    "packages/hoisted": { "name": "@ws/hoisted", "dependencies": { "foo": "^1.0.0" } },
    "packages/a/b": { "name": "@ws/nested", "dependencies": { "foo": "^3.0.0" } },
    "packages/a/node_modules/foo": { "version": "3.0.0" }
  }
}
